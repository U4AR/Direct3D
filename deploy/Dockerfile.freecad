FROM node:22-bookworm-slim
ARG FREECAD_VERSION=1.1.4
ARG FREECAD_SHA256=f6dc6ba676e5ac96a565ebc8d657232f94c6158e85b4352141bd1a46f6b43434
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl libgl1 libegl1 libxrender1 libxi6 libxfixes3 libxkbcommon0 libsm6 libopengl0 libfontconfig1 libnss3 libxcb-cursor0 && rm -rf /var/lib/apt/lists/*
COPY scripts/download-runtime.mjs /tmp/download-runtime.mjs
ARG RUNTIME_URL=https://github.com/FreeCAD/FreeCAD/releases/download/${FREECAD_VERSION}/FreeCAD_${FREECAD_VERSION}-Linux-x86_64-py311.AppImage
RUN node /tmp/download-runtime.mjs ${RUNTIME_URL} /tmp/freecad.AppImage ${FREECAD_SHA256} && chmod +x /tmp/freecad.AppImage && cd /opt && /tmp/freecad.AppImage --appimage-extract > /dev/null && mv squashfs-root freecad && rm /tmp/freecad.AppImage
WORKDIR /app
COPY package.json ./
COPY scripts ./scripts
COPY src/blender-contract.js ./src/blender-contract.js
COPY deploy/OPEN-SOURCE.md ./OPEN-SOURCE.md
RUN groupadd -g 10001 draw3d && useradd -u 10001 -g draw3d -d /tmp draw3d && mkdir /data && chown draw3d:draw3d /data
ENV MODELING_ENGINE=freecad FREECAD_PYTHON=/opt/freecad/usr/bin/python SESSION_DIR=/data ALLOW_NATIVE_GUI=0 HOME=/tmp QT_QPA_PLATFORM=offscreen PYTHONHOME=/opt/freecad/usr PYTHONPATH=/opt/freecad/usr/lib LD_LIBRARY_PATH=/opt/freecad/usr/lib
USER 10001:10001
EXPOSE 8790
CMD ["node","scripts/modeling-engine-server.mjs"]
