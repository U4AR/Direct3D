FROM node:22-bookworm-slim
ARG BLENDER_VERSION=4.5.9
ARG BLENDER_SHA256=dcdc3eca6c9825bb35a8033b689c053f3cb5a9b0cd2a61b2eac2a49436b4ad3d
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl xz-utils libgl1 libxrender1 libxi6 libxfixes3 libxkbcommon0 libsm6 && rm -rf /var/lib/apt/lists/*
COPY scripts/download-runtime.mjs /tmp/download-runtime.mjs
ARG RUNTIME_URL=https://download.blender.org/release/Blender4.5/blender-${BLENDER_VERSION}-linux-x64.tar.xz
RUN node /tmp/download-runtime.mjs ${RUNTIME_URL} /tmp/blender.tar.xz ${BLENDER_SHA256} && mkdir /opt/blender && tar -xf /tmp/blender.tar.xz -C /opt/blender --strip-components=1 && rm /tmp/blender.tar.xz
WORKDIR /app
COPY package.json ./
COPY scripts ./scripts
COPY src/blender-contract.js ./src/blender-contract.js
COPY deploy/OPEN-SOURCE.md ./OPEN-SOURCE.md
RUN groupadd -g 10001 draw3d && useradd -u 10001 -g draw3d -d /tmp draw3d && mkdir /data && chown draw3d:draw3d /data
ENV MODELING_ENGINE=blender BLENDER_PATH=/opt/blender/blender SESSION_DIR=/data ALLOW_NATIVE_GUI=0 MODELING_THREADS=2 HOME=/tmp XDG_CACHE_HOME=/tmp/cache
USER 10001:10001
EXPOSE 8790
CMD ["node","scripts/modeling-engine-server.mjs"]
