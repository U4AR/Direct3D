FROM node:22-bookworm-slim AS web
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-bookworm-slim AS freecad
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY scripts/download-runtime.mjs /tmp/download-runtime.mjs
RUN node /tmp/download-runtime.mjs https://github.com/FreeCAD/FreeCAD/releases/download/1.1.4/FreeCAD_1.1.4-Linux-x86_64-py311.AppImage /tmp/freecad.AppImage f6dc6ba676e5ac96a565ebc8d657232f94c6158e85b4352141bd1a46f6b43434 && chmod +x /tmp/freecad.AppImage && cd /opt && /tmp/freecad.AppImage --appimage-extract > /dev/null && mv squashfs-root freecad && rm /tmp/freecad.AppImage

FROM node:22-bookworm-slim AS blender
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates xz-utils && rm -rf /var/lib/apt/lists/*
COPY scripts/download-runtime.mjs /tmp/download-runtime.mjs
RUN node /tmp/download-runtime.mjs https://download.blender.org/release/Blender4.5/blender-4.5.9-linux-x64.tar.xz /tmp/blender.tar.xz dcdc3eca6c9825bb35a8033b689c053f3cb5a9b0cd2a61b2eac2a49436b4ad3d && mkdir /opt/blender && tar -xf /tmp/blender.tar.xz -C /opt/blender --strip-components=1 && rm /tmp/blender.tar.xz

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libgl1 libegl1 libxrender1 libxi6 libxfixes3 libxkbcommon0 libsm6 libopengl0 libfontconfig1 libnss3 libxcb-cursor0 && rm -rf /var/lib/apt/lists/* && groupadd -g 10001 draw3d && useradd -u 10001 -g draw3d -d /tmp draw3d && mkdir /data && chown draw3d:draw3d /data
WORKDIR /app
COPY --from=freecad /opt/freecad /opt/freecad
COPY --from=blender /opt/blender /opt/blender
COPY --from=web /app/dist ./dist
COPY --from=web /app/node_modules ./node_modules
COPY package.json ./
COPY scripts ./scripts
COPY src ./src
COPY agent-skills ./agent-skills
COPY deploy/OPEN-SOURCE.md ./OPEN-SOURCE.md
ENV NODE_ENV=production BRIDGE_HOST=0.0.0.0 BRIDGE_PORT=8080 PORT=8080 DRAW3D_STATIC_DIR=/app/dist SESSION_DIR=/data ALLOW_NATIVE_GUI=0 HOME=/tmp XDG_CACHE_HOME=/tmp/cache MODELING_THREADS=2 FREECAD_PYTHON=/opt/freecad/usr/bin/python FREECAD_PYTHONHOME=/opt/freecad/usr BLENDER_PATH=/opt/blender/blender QT_QPA_PLATFORM=offscreen
USER 10001:10001
CMD ["node","scripts/model-bridge.mjs"]
