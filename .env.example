# Server-only key. Never name this VITE_GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.1-flash-lite-image
GEMINI_FALLBACK_MODEL=
GEMINI_AUDIO_MODEL=models/gemini-3.5-flash-lite
BRIDGE_PORT=8788
SESSION_DIR=sessions
# For trusted HTTPS on a LAN, set certificate paths as process environment
# variables before npm run dev (Vite config reads these from process.env).
# HTTPS_KEY=C:/certs/quest-key.pem
# HTTPS_CERT=C:/certs/quest.pem

# PC-only multimodal agent for CAD and SculptGL (separate from image generation)
OPENAI_AGENT_MODEL=gpt-6-luna
OPENAI_AGENT_REASONING=medium
# OPENAI_API_KEY is read from the PC environment or private backend env file.

# AI Studio direct drawing editor (server only). Falls back to GEMINI_API_KEY.
DRAW3D_AGENT_PROVIDER=gemini
GEMINI_AGENT_MODEL=gemini-3.8-flash
GEMINI_AGENT_API_KEY=

GEMINI_AGENT_REASONING=low
GEMINI_AGENT_SERVICE_TIER=priority

# Container deployment uses backend-only Docker secrets; see deploy/README.md.
# GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key
# MODELING_SERVICE_TOKEN_FILE=/run/secrets/modeling_token
# BLENDER_SERVICE_URL=http://blender:8790
# FREECAD_SERVICE_URL=http://freecad:8790
# DRAW3D_STATIC_DIR=/app/dist
# DRAW3D_AGENT_ORIGINS=https://your-server.example
