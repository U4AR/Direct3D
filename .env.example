# Server-only key. Never name this VITE_GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-nano-banana-2.1
GEMINI_AUDIO_MODEL=models/gemini-3.5-flash-lite
BRIDGE_PORT=8788
SESSION_DIR=sessions
# For trusted HTTPS on a LAN, set certificate paths as process environment
# variables before npm run dev (Vite config reads these from process.env).
# HTTPS_KEY=C:/certs/quest-key.pem
# HTTPS_CERT=C:/certs/quest.pem
